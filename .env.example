# Required — see CONTACT_OPERATIONS.md. Never use a VITE_ prefix for secrets.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-standard-write-token
CONTACT_RATE_LIMIT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional namespace. Omit to use ayman-contact-production / preview / development.
# CONTACT_RATE_LIMIT_NAMESPACE=ayman-contact-preview

# Required — create a key at https://resend.com/api-keys
# Sign up with boujjarr@gmail.com so the test sender can deliver to that inbox.
RESEND_API_KEY=re_xxxxxxxx

# Optional (defaults shown). Override in Vercel if needed.
# CONTACT_TO_EMAIL=boujjarr@gmail.com
# CONTACT_FROM_EMAIL=Ayman Boujjar <onboarding@resend.dev>
#
# After you verify aymanboujjar.com in Resend, switch FROM to e.g.:
# CONTACT_FROM_EMAIL=Ayman Boujjar <contact@aymanboujjar.com>
