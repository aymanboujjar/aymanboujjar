{
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/llm.txt",
      "destination": "/llms.txt"
    },
    {
      "source": "/((?!api/|robots\\.txt$|sitemap\\.xml$|llms\\.txt$|404\\.html$|og-image\\.jpg$|favicon\\.ico$|Ayman_Boujjar_CV\\.pdf$|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
